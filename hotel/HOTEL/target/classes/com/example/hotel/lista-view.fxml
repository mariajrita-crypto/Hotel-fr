<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.hotel.ListaController">
    <!-- Sidebar Decorada -->
    <left>
        <VBox prefWidth="240.0" spacing="12.0" styleClass="sidebar">
            <VBox alignment="CENTER" spacing="4.0">
                <Label styleClass="brand-icon" text="🏛️" />
                <Label styleClass="sidebar-title" text="ATLAS HOTEL" />
                <Label styleClass="sidebar-subtitle" text="LUXURY &amp; COMFORT" />
            </VBox>

            <VBox spacing="8.0">
                <Button onAction="#onVoltar" prefWidth="210.0" styleClass="menu-button" text="👤   Novo Hóspede" />
                <Button prefWidth="210.0" styleClass="menu-button-active" text="📋   Lista de Hóspedes" />
            </VBox>
        </VBox>
    </left>

    <!-- Área da Tabela -->
    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>

            <VBox spacing="4.0">
                <Label styleClass="label-titulo" text="Hóspedes Registrados" />
                <Label styleClass="label-subtitulo" text="Consulta e gerenciamento dos clientes hospedados no Atlas Hotel" />
            </VBox>

            <TableView fx:id="tabelaClientes" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNome" prefWidth="150.0" text="Nome" />
                    <TableColumn fx:id="colCpf" prefWidth="120.0" text="CPF" />
                    <TableColumn fx:id="colTelefone" prefWidth="120.0" text="Telefone" />
                    <TableColumn fx:id="colEmail" prefWidth="150.0" text="E-mail" />
                    <TableColumn fx:id="colQuarto" prefWidth="75.0" text="Quarto" />
                    <TableColumn fx:id="colDias" prefWidth="65.0" text="Dias" />
                </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="12.0">
                <Button onAction="#onExcluir" styleClass="btn-danger" text="Excluir Registro" />
            </HBox>
        </VBox>
    </center>
</BorderPane>